{
  "name": "dsfr-tel",
  "version": "1.1.0",
  "description": "Un composant de saisie de téléphone pour Vue.js 3 reposant sur Libphonenumber et le DSFR.",
  "main": "dist/dsfr-tel.umd.js",
  "module": "dist/dsfr-tel.es.mjs",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "!dist/mobile/dsfr-tel.css",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "style": "dist/dsfr-tel.css",
  "scripts": {
    "dev": "vite --mode demo",
    "build": "vite build && vite build --mode mobile",
    "test:umd": "node scripts/check-umd.cjs",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview --outDir dist-demo",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "author": "Édouard Roger",
  "license": "MIT",
  "dependencies": {
    "libphonenumber-js": "^1.13.13"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^22.9.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.7.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^5.0.1",
    "vue": "^3.5.13",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "minimatch": "^10.2.3"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/dsfr-tel.es.mjs",
      "require": "./dist/dsfr-tel.umd.js"
    },
    "./mobile": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/mobile/dsfr-tel.es.mjs",
      "require": "./dist/mobile/dsfr-tel.umd.js"
    },
    "./dist/dsfr-tel.css": "./dist/dsfr-tel.css",
    "./style.css": "./dist/dsfr-tel.css"
  },
  "sideEffects": [
    "*.css",
    "*.vue"
  ],
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edouardroger/dsfr-tel.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "dsfr",
    "telephone",
    "libphonenumber",
    "rgaa",
    "accessibilite"
  ],
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
